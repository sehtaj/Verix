# Required for generation, investigation explanations, and fix proposals.
LLM_API_KEY=

# Optional locally. Set this to the exact comma-separated Vercel origin(s) in
# production. Wildcards, credentials, paths, queries, and fragments are rejected.
# VERIX_CORS_ORIGINS=https://verix.example

# Optional public-demo ceilings. Defaults are shown below.
# VERIX_MAX_REQUEST_BYTES=262144
# VERIX_MAX_CONCURRENT_JOBS=2
# VERIX_REQUESTS_PER_MINUTE=30
# VERIX_LLM_CALLS_PER_DAY=100
# VERIX_LLM_MAX_OUTPUT_TOKENS=4096
# VERIX_STALE_WORKSPACE_SECONDS=3600
